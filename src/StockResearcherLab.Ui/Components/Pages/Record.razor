@page "/record"
@using System.Net.Http.Json
@using System.Globalization
@using StockResearcherLab.Api.Contracts
@inject IHttpClientFactory Http

@* U8. What the store holds for one name on one date, and where each number came
   from [D-109].

   Static server rendering and a plain GET form. The page has no state of its own:
   the ticker and the date are in the URL, so a finding is a link somebody can paste
   into a commit message rather than a set of keystrokes to describe.

   Nothing here computes anything. Every figure is a stored value or an absence, and
   where one would have to be derived the panel shows the inputs and says so. *@

<PageTitle>Record</PageTitle>

<h1>Record</h1>
<p class="sub">What this system knows about one name on one date, and where each number came from.</p>

<form method="get" class="ask">
    <label>Ticker <input name="ticker" value="@Ticker" placeholder="AAPL.US" size="12" /></label>
    <label>Date <input name="date" value="@DateText" placeholder="2026-08-12" size="12" /></label>
    <button type="submit">Read</button>
    <a href="/" class="sub">runs</a>
</form>

@if (Ticker is null || Date is null)
{
    <p class="empty">A ticker and a date, and this reads the record for them.</p>
}
else if (_error is not null)
{
    <p class="fail">Could not reach the API: @_error</p>
}
else if (_view is null)
{
    <p class="empty">Loading.</p>
}
else
{
    <h2>@_view.Ticker on @DateText</h2>

    @* ------------------------------------------------------ membership --- *@
    <section>
        <h3>Membership</h3>

        @{
            var m = _view.Membership;
            var row = m.InForce;
        }

        @if (m.Identity is null)
        {
            <p class="empty">
                The store holds no <code>security</code> row for this ticker, so it has never been
                admitted and has no identity here. That is absence, not rejection.
            </p>
        }
        else
        {
            <table class="pairs">
                <tbody>
                    <tr><th>Name</th><td>@Absent(m.Identity.Name)</td></tr>
                    <tr>
                        <th>First bar held</th>
                        <td>
                            @Absent(m.Identity.FirstSeen)
                            <span class="sub">earliest bar retained, not first listed</span>
                        </td>
                    </tr>
                    <tr><th>Last bar held</th><td>@Absent(m.Identity.LastSeen)</td></tr>
                    <tr><th>Delisted</th><td>@Absent(m.Identity.DelistedDate)</td></tr>
                </tbody>
            </table>
        }

        @if (row is not null && row.IsActive)
        {
            <p class="ok">A member on this date.</p>
            <table class="pairs">
                <tbody>
                    <tr>
                        <th>Evaluated</th>
                        <td>
                            @row.EvaluationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                            <span class="sub">C01 runs weekly, so this is the row in force rather than a row for the date asked</span>
                        </td>
                    </tr>
                    <tr><th>Size bucket</th><td>@Absent(row.SizeBucket)</td></tr>
                    <tr><th>Sector</th><td>@Absent(row.Sector)</td></tr>
                    <tr><th>Market cap</th><td class="num">@Money(row.MarketCap)</td></tr>
                </tbody>
            </table>
        }
        else if (row is not null)
        {
            <p class="fail">
                Not a member on this date. The row in force is the departure C01 wrote on
                @row.EvaluationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                which ended a membership rather than recording an absence.
            </p>
        }
        else
        {
            <p class="empty">No <code>security_daily</code> row had been written for this ticker by this date.</p>
        }

        @if (m.Rejection is not null)
        {
            <p class="fail">
                Rejected on <b>@m.Rejection.Criterion</b>, evaluated
                @m.Rejection.EvaluationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture).
            </p>
            <p class="sub">
                That is the criterion the evaluation stopped on, not the only one this name failed.
                D-4 is a conjunction tested in a fixed order.
            </p>
        }
        else if (row is null || !row.IsActive)
        {
            <p class="empty">
                No rejection row either, so this name was not among those C01 evaluated on that date.
                The inputs panel is where an absence of bars shows.
            </p>
        }

        <h4>Criteria in force on @DateText</h4>
        <table>
            <thead><tr><th>Key</th><th>Value</th><th>Version</th><th>Set on</th></tr></thead>
            <tbody>
                @foreach (var t in m.Thresholds)
                {
                    <tr>
                        <td><code>@t.Key</code></td>
                        <td class="num">@Absent(t.Value)</td>
                        <td class="num">@Absent(t.Version?.ToString(CultureInfo.InvariantCulture))</td>
                        <td>@Absent(t.SetOn)</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="sub">
            Resolved as of the date being viewed, never as of now. A version absent here means the
            key had not come into force yet on that date.
        </p>
    </section>

    @* --------------------------------------------------------- metrics --- *@
    <section>
        <h3>Metrics</h3>

        @{
            var mx = _view.Metrics;
        }

        @if (mx.Cell is null)
        {
            <p class="empty">
                This name had no membership row in force on this date, so it belonged to no cell and
                nothing ranked it. The raw values below are whatever the compute layer wrote.
            </p>
        }
        else
        {
            <p class="sub">
                Ranked in <b>@Absent(mx.Cell.SizeBucket)</b> / <b>@Absent(mx.Cell.Sector)</b>.
                A percentile over three members and one over eighty are the same number, so the
                cell column is the one to read first.
            </p>
        }

        @if (!mx.Populated)
        {
            <p class="fail">
                Cell populations are <b>not populated for this date</b>.
                @if (mx.CoveredFrom is null)
                {
                    <text>The pass that writes them has not run.</text>
                }
                else
                {
                    <text>
                        The pass has reached
                        @mx.CoveredFrom.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        to
                        @mx.CoveredTo!.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        and this date is outside it.
                    </text>
                }
                That is a different state from a cell that does not exist, and the cell columns below
                are blank for that reason rather than because nothing ranked this name.
            </p>
        }

        <table>
            <thead>
                <tr>
                    <th>Metric</th>
                    <th style="text-align:right">Value</th>
                    <th style="text-align:right">Pctile</th>
                    <th style="text-align:right">Cell n</th>
                    <th style="text-align:right">Bucket n</th>
                    <th style="text-align:right">Floor</th>
                    <th>Ranked in</th>
                    <th>Store</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mr in mx.Metrics)
                {
                    <tr>
                        <td><code>@mr.Metric</code></td>
                        <td class="num">@Figure(mr.Value)</td>
                        <td class="num">@Figure(mr.Percentile)</td>
                        <td class="num">@Count(mr.CellMembers, mx.Populated)</td>
                        <td class="num">@Count(mr.BucketMembers, mx.Populated)</td>
                        <td class="num">@Count(mr.MinMembers, mx.Populated)</td>
                        <td class="@ScopeClass(mr)">@Scope(mr, mx.Populated)</td>
                        <td class="sub">@mr.Table</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="sub">
            Every figure here is stored. <code>Ranked in</code> is written by the percentile engine
            rather than worked out from the count against the floor, so this page compares nothing.
            It reads <b>not applicable</b> where the value is absent: the stored scope describes the
            cell, and a name with no value was not in the population that cell was ranked over. The
            counts still show, because a cell that exists without this name in it is a different
            fact from a cell that does not exist.
        </p>
    </section>

    @* ---------------------------------------------------------- inputs --- *@
    <section>
        <h3>Inputs</h3>
        <p class="sub">What the compute layer read. The panel to open when a number above looks wrong.</p>

        @{
            var inp = _view.Inputs;
        }

        <h4>Last @inp.BarWindow bars at or before @DateText</h4>
        @if (inp.Bars.Count == 0)
        {
            <p class="empty">No <code>price_daily</code> bar at or before this date. The store holds nothing to compute from.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Date</th><th style="text-align:right">Close</th><th style="text-align:right">Adj close</th><th style="text-align:right">Volume</th></tr></thead>
                <tbody>
                    @foreach (var b in inp.Bars)
                    {
                        <tr>
                            <td>@b.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td class="num">@Figure(b.Close)</td>
                            <td class="num">@Figure(b.AdjClose)</td>
                            <td class="num">@Whole(b.Volume)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h4>Filings readable on @DateText</h4>
        @if (inp.Filings.Count == 0)
        {
            <p class="empty">
                No <code>fundamental_snapshot</code> row was readable on this date, which is what
                <code>no_fundamentals</code> means above if that is the criterion recorded.
            </p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Effective</th><th>Period end</th><th>Filed</th>
                        <th>Unknown reason</th><th>Type</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in inp.Filings)
                    {
                        <tr>
                            <td>@Absent(f.FilingDateEffective)</td>
                            <td>@f.PeriodEnd.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td>@Absent(f.FilingDate)</td>
                            <td class="@(f.UnknownReason == "none" ? "" : "fail")">@Absent(f.UnknownReason)</td>
                            <td>@Absent(f.PeriodType)</td>
                            <td class="ok">@(f.MostRecentReadable ? "newest readable" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="sub">
                Filtered and ordered on <code>filing_date_effective</code>, never on
                <code>period_end</code>. <b>Which valuation column came from which filing is not
                recorded</b>: <code>valuation_daily</code> stores the value and not its source row,
                so the newest readable filing is marked and nothing more is claimed.
            </p>
        }

        <h4>Sentiment days inside @inp.SentimentWindowDays days</h4>
        @if (inp.SentimentDays.Count == 0)
        {
            <p class="empty">No <code>sentiment_daily</code> row inside the window.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Date</th><th style="text-align:right">Articles</th><th style="text-align:right">Score</th></tr></thead>
                <tbody>
                    @foreach (var s in inp.SentimentDays)
                    {
                        <tr>
                            <td>@s.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td class="num">@Whole(s.ArticleCount)</td>
                            <td class="num">@Figure(s.SentimentScore)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="sub">
                @inp.SentimentDays.Count day(s) carry a row out of @inp.SentimentWindowDays.
                Days with no row are not listed and are not zeroes: the series is sparse by
                construction and a zero would say attention was measured at nothing.
            </p>
        }

        <h4>Insider filings inside @inp.InsiderWindowDays days</h4>
        @if (inp.InsiderFilings.Count == 0)
        {
            <p class="empty">No <code>insider_transaction</code> row filed inside the window.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Filed</th><th>Transacted</th><th>Owner</th>
                        <th>Code</th><th style="text-align:right">Shares</th><th style="text-align:right">Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in inp.InsiderFilings)
                    {
                        <tr>
                            <td>@Absent(f.FiledAt)</td>
                            <td>@Absent(f.TransactionDate)</td>
                            <td>@Absent(f.OwnerName)</td>
                            <td class="@(f.TransactionCode == "P" ? "ok" : "")">@Absent(f.TransactionCode)</td>
                            <td class="num">@Figure(f.Shares)</td>
                            <td class="num">@Figure(f.PricePerShare)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="sub">
                Windowed on <code>filed_at</code>, which is when the filing became public, rather
                than on the transaction date. Both are shown so the lag is inspectable.
                <code>P</code> is an open-market purchase and is the only code S4 counts.
            </p>
        }
    </section>

    @* -------------------------------------------------- market context --- *@
    <section>
        <h3>Market context</h3>

        @{
            var mk = _view.Market;
        }

        @if (!mk.Present)
        {
            <p class="empty">
                No <code>market_context_daily</code> row for this date. C10 writes one row per date,
                so this is a date it never ran for rather than a date with no market.
            </p>
        }
        else
        {
            <p>
                Breadth <b>@Figure(mk.Breadth)</b>
                &nbsp;·&nbsp; regime <b>@Absent(mk.RegimeLabel)</b>
                &nbsp;·&nbsp; VIX <b>@Figure(mk.Vix)</b>
                &nbsp;·&nbsp; @Absent(mk.Sector) composite <b>@Figure(mk.SectorComposite)</b>
            </p>
            <p class="sub">
                VIX is absent by design: the bulk end-of-day feed carries equities and the index is
                not among them, so the column is written null rather than proxied. The composite is
                read out of the stored object by sector key, not recomputed.
            </p>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery] public string? Ticker { get; set; }

    [SupplyParameterFromQuery] public string? Date { get; set; }

    private RecordView? _view;
    private string? _error;

    private string DateText => Date ?? "";

    protected override async Task OnParametersSetAsync()
    {
        _view = null;
        _error = null;

        if (string.IsNullOrWhiteSpace(Ticker) || string.IsNullOrWhiteSpace(Date))
        {
            return;
        }

        if (!DateOnly.TryParseExact(Date, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var date))
        {
            _error = $"'{Date}' is not a date in yyyy-MM-dd form.";
            return;
        }

        try
        {
            var client = Http.CreateClient("api");
            _view = await client.GetFromJsonAsync<RecordView>(
                $"/api/record/{Uri.EscapeDataString(Ticker)}/{date:yyyy-MM-dd}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    // Absent is shown as absent and never as blank or zero. A blank cell reads as a
    // rendering gap and a zero is a real value carrying meaning [CLAUDE.md section 6].
    private static string Absent(string? value)
        => string.IsNullOrEmpty(value) ? "absent" : value;

    private static string Absent(DateOnly? value)
        => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "absent";

    private static string Money(decimal? value)
        => value?.ToString("N0", CultureInfo.InvariantCulture) ?? "absent";

    private static string Figure(decimal? value)
        => value?.ToString("G6", CultureInfo.InvariantCulture) ?? "absent";

    private static string Figure(double? value)
        => value?.ToString("F1", CultureInfo.InvariantCulture) ?? "absent";

    private static string Whole(long? value)
        => value?.ToString("N0", CultureInfo.InvariantCulture) ?? "absent";

    private static string Whole(int? value)
        => value?.ToString("N0", CultureInfo.InvariantCulture) ?? "absent";

    // Three states, not two. Absent means the cell row does not exist for this name;
    // not populated means the pass has not reached this date and the figure is not
    // written yet. A blank cell would read as the first when it is the second, which is
    // the distinction 3.5.2 is built around.
    private static string Count(int? value, bool populated)
        => value?.ToString("N0", CultureInfo.InvariantCulture) ?? (populated ? "absent" : "not populated");

    // Where THIS name was ranked, which is not the same question as what its cell did.
    //
    // ranked_scope is a property of the cell and is correct in the store: a cell of 99
    // non-null members ranked at cell level whether or not this name was one of them.
    // Rendered per row without the value beside it, it says the opposite of what
    // happened, and a reader sees "sector cell" against a name that was never ranked.
    //
    // A null value is an exact test for that, in both directions: the percentile is null
    // exactly when the value is, because a name with no value is not in the population
    // the rank is taken over [METRICS.md section 6.2]. So the value decides this column
    // and the cell's own verdict is shown only where the name was in it.
    //
    // The cell counts beside it still render, and deliberately: they say the cell exists
    // and this name is absent from it, which is a different fact from the cell not
    // existing.
    private static string Scope(MetricRow row, bool populated)
    {
        if (row.Value is null)
        {
            return "not applicable";
        }

        return row.RankedScope switch
        {
            "cell" => "sector cell",
            "bucket" => "size bucket",
            "none" => "nothing",
            _ => populated ? "absent" : "not populated",
        };
    }

    private static string ScopeClass(MetricRow row) => row.Value is null
        ? "na"
        : row.RankedScope switch
        {
            "cell" => "ok",
            "none" => "fail",
            _ => "",
        };
}
