<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockResearcherLab.Core\StockResearcherLab.Core.csproj" />
    <ProjectReference Include="..\StockResearcherLab.Data\StockResearcherLab.Data.csproj" />
    <ProjectReference Include="..\StockResearcherLab.Pipeline\StockResearcherLab.Pipeline.csproj" />
    <!-- Referenced so the Api is always rebuilt before ApiIsolationTests reads
         its deps.json. Without this nothing in the test run builds the Api, and
         that assertion would pass against whatever was last on disk. -->
    <ProjectReference Include="..\StockResearcherLab.Api\StockResearcherLab.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Never committed. Copied beside the test binary so the configuration
         builder finds it at run time [D-55]. -->
    <None Update="appsettings.Secrets.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Secrets.json')" />
  </ItemGroup>

</Project>
