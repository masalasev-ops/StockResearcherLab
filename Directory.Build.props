<Project>

  <!-- Shared MSBuild properties for every project in the repository. Phase 0
       checkpoint 0.1 sets the full set; the phase P scratch project that
       preceded it carried only what it needed and was deleted at 0.1 [O.9]. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- CLAUDE.md section 6: nullable reference types on, warnings as errors.
         Null means unknown here, never zero, and the compiler is the cheapest
         place that distinction is enforced. -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- CLAUDE.md section 6: a decimal comma reaching a file, a prompt or the
         database breaks things silently. Call sites still pass
         CultureInfo.InvariantCulture explicitly; this is the backstop. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Deterministic output. Two builds of the same source produce the same
         bytes, which is the build-level form of the property section 6 asks of
         every stage. -->
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
